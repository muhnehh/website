@misc{nehan2025dustadapt,
  author       = {Nehan, Muhammed},
  title        = {{DustAdapt}: A Drift-Triggered Framework for Edge Air Quality Forecasting
                  via BN-TTA and Adaptive Conformal Inference},
  year         = {2025},
  note         = {Single-author preprint},
  abstract     = {We present DustAdapt, a drift-triggered inference framework combining
                  CUSUM change detection, batch-normalization test-time adaptation (BN-TTA),
                  and Adaptive Conformal Inference for air quality forecasting on ARMv8 edge
                  devices. DustAdapt achieves 0.95ms inference latency, 94.18% uncertainty
                  coverage, and a 68% compute reduction under distribution shift without
                  retraining or cloud connectivity.},
  keywords     = {edge ML, test-time adaptation, conformal prediction, air quality,
                  distribution shift, CUSUM, on-device inference},
  url          = {},
}
